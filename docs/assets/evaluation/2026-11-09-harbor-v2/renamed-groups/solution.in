# P3 reference, protocol v1. Gap means initial outermost atomic-plane distance.
units metal
atom_style atomic
boundary p p s
variable a equal 3.3079
lattice bcc ${a}
region box block 0 20 0 20 -10 100 units lattice
create_box 1 box
# Exclude the upper boundary plane to obtain exactly 2*Nx*Ny*Nz atoms.
region sample_region block 0 20 0 20 0 39.999999 units lattice
region flyer_region block 0 20 0 20 60 79.999999 units lattice
create_atoms 1 region sample_region
create_atoms 1 region flyer_region
group sample region sample_region
group flyer region flyer_region
variable shift equal 39.5*v_a+15-60*v_a
displace_atoms flyer move 0 0 ${shift} units box
mass 1 92.90638
pair_style eam/alloy
pair_coeff * * /app/inputs/prompt3.potential Nb
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
velocity all create 300 381729 mom yes rot no dist gaussian
timestep 0.001
fix equilibrate all nvt temp 300 300 0.1
thermo 1000
run 100000
unfix equilibrate
velocity flyer set 0 0 -20 sum yes units box
fix impact all nve
run 100000
