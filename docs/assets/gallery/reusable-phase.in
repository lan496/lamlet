units metal
atom_style atomic
read_data examples/gallery/structure.data
pair_style lj/cut 8.5
pair_coeff * * 0.0103 3.4
compute T all temp
fix bath all nvt temp 300 300 0.1
        fix_modify bath temp T
        run 10000
unfix bath
uncompute T
compute T all temp
fix bath all nvt temp 400 400 0.1
        fix_modify bath temp T
        run 10000
unfix bath
uncompute T
compute T all temp
fix bath all nvt temp 500 500 0.1
        fix_modify bath temp T
        run 10000
unfix bath
uncompute T
compute T all temp
fix bath all nvt temp 600 600 0.1
        fix_modify bath temp T
        run 10000
unfix bath
uncompute T
