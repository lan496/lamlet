@let dt = 2 fs
# Ordinary commands keep their whitespace and comments.
units metal
atom_style atomic
timestep @{dt}
region box block 0 5 0 5 0 5
create_box 1 box
create_atoms 1 single 2.5 2.5 2.5
mass 1 40.0
pair_style zero 3.0
pair_coeff * *
fix integrate all nve
@for steps in [0, 0] {
    run @{steps}
}
unfix integrate
